# Never commit .env. Initial password only; use Change password after signing in.
# Leave blank to generate /data/admin-password.txt on first boot.
ADMIN_PASSWORD=
PORT=8088
BIND_ADDRESS=0.0.0.0
TZ=Europe/London
STACKS_ROOT=/opt/stacks
MAX_BACKUP_GB=10
# Enable when using an HTTPS reverse proxy.
COOKIE_SECURE=false
